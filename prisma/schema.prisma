generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled connection (-pooler hostname) doesn't support PG advisory
  // locks, so `prisma migrate deploy` hangs and fails with P1002. Use the
  // unpooled (direct) URL for migrations; runtime queries still use the pool.
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  password           String?
  image              String?
  role               UserRole            @default(FREE)
  emailVerified      DateTime?
  razorpayCustomerId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  hasUsedTrial       Boolean             @default(false)
  totalAudits        Int                 @default(0)
  currentMonthAudits Int                 @default(0)
  lastAuditReset     DateTime            @default(now())

  // Team-referral attribution: set at signup, immutable thereafter.
  referredByTeamId String?
  referredByTeam   Team?   @relation(fields: [referredByTeamId], references: [id], onDelete: SetNull)

  accounts           Account[]
  apiKeys            ApiKey[]
  audits             Audit[]
  auditLogs          AuditLog[]
  monitoredContracts MonitoredContract[]
  notifications      Notification[]
  payments           Payment[]
  sessions           Session[]
  subscription       Subscription?
  webhooks           Webhook[]
  teamCommissions    TeamCommission[]

  @@index([email])
  @@index([referredByTeamId])
}

// Marketing / branding partners that earn a commission on referred subscriptions.
// Seeded via scripts/seed-team.ts — not user-managed.
model Team {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  commissionRate  Float            @default(0.20) // e.g. 0.20 = 20% of first paid month
  contactEmail    String?
  payoutDetails   String?          // free-form: UPI ID, bank ref, etc.
  isActive        Boolean          @default(true)
  clickCount      Int              @default(0)
  signupCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  referredUsers   User[]
  commissions     TeamCommission[]

  @@index([code])
  @@index([isActive])
}

// One row per qualifying first-paid-upgrade. The audit trail used by the
// monthly payout report.
model TeamCommission {
  id                 String   @id @default(cuid())
  teamId             String
  userId             String
  paymentId          String   @unique // 1 row per payment, prevents double-credit
  plan               UserRole
  paymentAmountPaise Int
  commissionPaise    Int
  createdAt          DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([teamId, createdAt])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  plan                   UserRole           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  razorpaySubscriptionId String?            @unique
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  isTrial                Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  amount            Int
  currency          String   @default("INR")
  status            String
  plan              UserRole
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Audit {
  id                 String              @id @default(cuid())
  userId             String
  contractName       String
  contractAddress    String?
  contractCode       String?
  chain              ChainType           @default(ETHEREUM)
  contractStandard   String?
  language           String?
  status             AuditStatus         @default(PENDING)
  score              Int?
  report             String?
  summary            String?
  reportId           String?             @unique // H-05: public share ID (indexed for O(log n) lookup)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentReports       AgentReport[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings           Finding[]
  monitoredContracts MonitoredContract[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model AgentReport {
  id          String      @id @default(cuid())
  auditId     String
  agentType   AgentType
  findings    String?
  summary     String?
  status      AuditStatus @default(PENDING)
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  error       String?
  audit       Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([agentType])
}

model Finding {
  id             String          @id @default(cuid())
  auditId        String
  agentType      AgentType
  title          String
  description    String
  severity       FindingSeverity
  lineNumber     Int?
  codeSnippet    String?
  recommendation String?
  createdAt      DateTime        @default(now())
  audit          Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
}

model MonitoredContract {
  id          String    @id @default(cuid())
  userId      String
  auditId     String?
  name        String
  address     String
  chain       ChainType @default(ETHEREUM)
  isActive    Boolean   @default(true)
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  audit       Audit?    @relation(fields: [auditId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address, chain])
  @@index([userId])
  @@index([address])
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  key       String    @unique
  userId    String
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  subscribedAt     DateTime @default(now())
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique @default(cuid())

  @@index([email])
  @@index([unsubscribeToken])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum UserRole {
  FREE
  PREMIUM
  ENTERPRISE
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum AuditStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AgentType {
  REENTRANCY_AGENT
  OVERFLOW_AGENT
  ACCESS_CONTROL_AGENT
  LOGIC_AGENT
  GAS_DOS_AGENT
  DEFI_AGENT
  BACKDOOR_AGENT
  SIGNATURE_AGENT
  SLITHER_AGENT
  GEMINI_AGENT
  CLAUDE_AGENT
  SECURITY
  GAS_OPTIMIZATION
  COMPLIANCE
  ERC20_AGENT
  ERC721_AGENT
  ERC1155_AGENT
  ERC4626_AGENT
  ERC1967_AGENT
  ERC1271_AGENT
}

enum ChainType {
  ETHEREUM
  BSC
  POLYGON
  AVALANCHE
  ARBITRUM
  OPTIMISM
  BASE
  TON
  SOLANA
  BITCOIN
  TRON
  COSMOS
  POLKADOT
}
