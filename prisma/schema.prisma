generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  clerkId            String?             @unique
  email              String              @unique
  name               String?
  password           String?
  image              String?
  role               UserRole            @default(FREE)
  emailVerified      DateTime?
  razorpayCustomerId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  hasUsedTrial       Boolean             @default(false)
  totalAudits        Int                 @default(0)
  currentMonthAudits Int                 @default(0)
  lastAuditReset     DateTime            @default(now())
  accounts           Account[]
  apiKeys            ApiKey[]
  audits             Audit[]
  auditLogs          AuditLog[]
  monitoredContracts MonitoredContract[]
  notifications      Notification[]
  payments           Payment[]
  sessions           Session[]
  subscription       Subscription?
  webhooks           Webhook[]
  organizations      OrganizationMember[]
  analyses           Analysis[]

  @@index([email])
}

// Workspace IDE analyses (ported from Sentinel OS). One row per "Analyze" run
// in the Solidity workspace. Stores AI findings, optimized code, gas + Mantle
// compatibility data. Distinct from the heavyweight Audit/Finding pipeline.
model Analysis {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename             String
  originalCode         String   @db.Text
  optimizedCode        String?  @db.Text
  securityScore        Int?
  severityTag          String? // CRITICAL | HIGH_RISK | MEDIUM_RISK | LOW_RISK | CRITICAL_PASS
  vulnerabilities      Json?
  optimizations        Json?
  optimizationInsights Json?
  gasSavedPercent      Decimal?
  gasProjection        Json?
  mantleCompatibility  Json?
  summary              String?  @db.Text
  address              String?
  network              String? // "mainnet" | "testnet"
  changedLines         Json?
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  plan                   UserRole           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  razorpaySubscriptionId String?            @unique
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  isTrial                Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  amount            Int
  currency          String   @default("INR")
  status            String
  plan              UserRole
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Audit {
  id                 String              @id @default(cuid())
  userId             String
  contractName       String
  contractAddress    String?
  contractCode       String?
  chain              ChainType           @default(ETHEREUM)
  status             AuditStatus         @default(PENDING)
  score              Int?
  report             String?
  summary            String?
  reportId           String?             @unique // H-05: public share ID (indexed for O(log n) lookup)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  agentReports       AgentReport[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings           Finding[]
  monitoredContracts MonitoredContract[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model AgentReport {
  id          String      @id @default(cuid())
  auditId     String
  agentType   AgentType
  findings    String?
  summary     String?
  status      AuditStatus @default(PENDING)
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  error       String?
  audit       Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([agentType])
}

model Finding {
  id             String          @id @default(cuid())
  auditId        String
  agentType      AgentType
  title          String
  description    String
  severity       FindingSeverity
  lineNumber     Int?
  codeSnippet    String?
  recommendation String?
  createdAt      DateTime        @default(now())

  // ── v4 analysis-core scoring (deterministic, persisted) ──────────────────
  /// Stable id: sha256(file:category:lineStart) — dedup key across re-runs.
  fingerprint    String          @default("")
  /// 0–100 Bayesian confidence from computeConfidence.
  confidence     Int             @default(0)
  /// Count of independent tools that confirmed this finding.
  confirmedBy    Int             @default(1)
  /// Canonical VulnerabilityCategory (e.g. "reentrancy").
  category       String?
  swcId          String?
  cweIds         String[]        @default([])
  /// "proven" | "likely" | "theoretical" | "unconfirmed".
  exploitability String          @default("theoretical")
  /// ToolDetection[] — which tools/detectors fired, with raw output/traces.
  detectors      Json?
  /// Evidence[] — typed evidence records (static/symbolic/fuzz/concrete).
  evidence       Json?

  audit          Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, fingerprint])
  @@index([auditId])
  @@index([severity])
  @@index([category])
}

model MonitoredContract {
  id          String    @id @default(cuid())
  userId      String
  auditId     String?
  name        String
  address     String
  chain       ChainType @default(ETHEREUM)
  isActive    Boolean   @default(true)
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  audit       Audit?    @relation(fields: [auditId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address, chain])
  @@index([userId])
  @@index([address])
}

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  key       String    @unique
  userId    String
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
}

model Webhook {
  id        String            @id @default(cuid())
  userId    String
  url       String
  secret    String            // HMAC-SHA256 signing secret (stored encrypted)
  events    String[]
  active    Boolean           @default(true)
  isActive  Boolean           @default(true) // legacy alias — use active
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  statusCode Int
  success    Boolean
  attempt    Int
  error      String?
  createdAt  DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  subscribedAt     DateTime @default(now())
  isActive         Boolean  @default(true)
  unsubscribeToken String   @unique @default(cuid())

  @@index([email])
  @@index([unsubscribeToken])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum UserRole {
  FREE
  PREMIUM
  ENTERPRISE
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum AuditStatus {
  PENDING
  PROCESSING
  DETERMINISTIC_COMPLETE  // deterministic pass done, AI pass queued
  AI_COMPLETE             // AI enrichment done, report being generated
  COMPLETED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AgentType {
  REENTRANCY_AGENT
  OVERFLOW_AGENT
  ACCESS_CONTROL_AGENT
  LOGIC_AGENT
  GAS_DOS_AGENT
  DEFI_AGENT
  BACKDOOR_AGENT
  SIGNATURE_AGENT
  SLITHER_AGENT
  GEMINI_AGENT
  CLAUDE_AGENT
  SECURITY
  GAS_OPTIMIZATION
  COMPLIANCE
  ERC20_AGENT
  ERC721_AGENT
  ERC1155_AGENT
  ERC4626_AGENT
  ERC1967_AGENT
  ERC1271_AGENT
}

enum ChainType {
  // EVM
  ETHEREUM
  BSC
  POLYGON
  AVALANCHE
  ARBITRUM
  OPTIMISM
  BASE
  LINEA
  SCROLL
  ZKSYNC
  // Non-EVM
  SOLANA
  COSMWASM
  INK
  TON
  STARKNET
  NEAR
  SUI
  APTOS
}

// ── Multi-tenancy: Organizations ─────────────────────────────────────────────
// Organizations group users under a single billing entity (team/enterprise).
// All audits belong to a user; organizations share quota across members.

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique   // used in API paths and reports
  plan        UserRole             @default(FREE)
  apiKey      String?              @unique   // org-level API key
  webhookUrl  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  installations GitHubInstallation[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrgMemberRole    @default(MEMBER)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ── GitHub App Integration ────────────────────────────────────────────────────

model GitHubInstallation {
  id              String       @id @default(cuid())
  installationId  Int          @unique  // GitHub's installation ID
  accountLogin    String                // GitHub org/user login
  accountType     String                // "Organization" | "User"
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  repositories    GitHubRepo[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([installationId])
  @@map("github_installations")
}

model GitHubRepo {
  id             String              @id @default(cuid())
  installationId String
  repoId         Int                 // GitHub repo ID
  fullName       String              // e.g. "orgname/reponame"
  defaultBranch  String              @default("main")
  scanEnabled    Boolean             @default(true)
  installation   GitHubInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  prScans        GitHubPrScan[]
  createdAt      DateTime            @default(now())

  @@unique([installationId, repoId])
  @@index([fullName])
  @@map("github_repos")
}

// Tracks a CI scan triggered by a GitHub PR/push event.
model GitHubPrScan {
  id          String      @id @default(cuid())
  repoId      String
  prNumber    Int?
  commitSha   String
  auditId     String?     // linked Audit once created
  status      String      @default("pending")
  checkRunId  Int?        // GitHub Check Run ID for status reporting
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  repo        GitHubRepo  @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@index([commitSha])
  @@map("github_pr_scans")
}

// ── Signed Audit Reports ──────────────────────────────────────────────────────
// Immutable signed artifact stored separately from the mutable Audit record.

model AuditReport {
  id            String   @id @default(cuid())
  auditId       String   @unique
  version       Int      @default(1)
  // Cryptographic signature of the report content (Ed25519, base64)
  signature     String
  // SHA256 of the canonical report JSON (hex)
  contentHash   String
  // Storage: local FS path or S3 key
  storagePath   String
  storageType   String   @default("local")  // "local" | "s3"
  // Report formats generated
  pdfPath       String?
  sarifPath     String?
  jsonPath      String?
  // Public presigned URL (expires)
  publicUrl     String?
  publicUrlExp  DateTime?
  generatedBy   String   // service version string
  createdAt     DateTime @default(now())

  @@index([auditId])
  @@index([contentHash])
  @@map("audit_reports")
}

// ── pgvector-backed exploit knowledge base ────────────────────────────────────
// embedding is stored as a native PostgreSQL vector(1536) type.
// Prisma does not natively understand this type — all vector reads/writes
// use prisma.$queryRaw / prisma.$executeRaw with explicit ::vector casting.
model VulnerabilityKnowledgeBase {
  id            String   @id @default(uuid())
  name          String
  protocol      String?
  date          DateTime?
  amountLostUsd BigInt?
  swcIds        String[]
  category      String   @default("other")
  severity      String   @default("critical")
  chain         String   @default("ethereum")
  codePattern   String
  // embedding: vector(1536) — NOT declared here; added via raw SQL migration
  // to avoid Prisma's Unsupported() type losing the index on re-generate.
  description   String
  exploitTx     String?
  fixPattern    String?
  sourceUrl     String?
  embeddingAt   DateTime? // set when the vector is populated
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([severity])
  @@index([chain])
  @@map("vulnerability_knowledge_base")
}

// Tracks every BullMQ audit job for observability and stuck-job recovery.
model AuditJob {
  id          String    @id @default(cuid())
  auditId     String
  queueName   String
  jobId       String    @unique // BullMQ job ID (for idempotency)
  status      String    @default("queued") // queued | processing | completed | failed
  attempts    Int       @default(0)
  lastError   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([auditId])
  @@index([status])
  @@index([queueName, status])
  @@map("audit_jobs")
}

// Runtime overlay for analysis-core's detector→category map (Phase 4).
// Lets TPRs be re-calibrated from the validation corpus without a redeploy.
// The in-code TABLE in packages/analysis-core/src/category-map.ts is the
// build-time default; rows here override it by (tool, detectorName).
model DetectorCategoryMap {
  id           String   @id @default(cuid())
  tool         String
  detectorName String
  category     String
  swcId        String   @default("SWC-000")
  tpr          Float    // calibrated true-positive rate, 0–1
  updatedAt    DateTime @updatedAt

  @@unique([tool, detectorName])
  @@index([category])
  @@map("detector_category_map")
}

// Per-finding AI enhancements, stored separately for queryability.
model FindingEnhancement {
  id                   String   @id @default(cuid())
  findingId            String   @unique
  narrativeExplanation String
  exploitScenario      String
  fixRecommendation    String
  fixCode              String?
  businessImpact       String?
  similarExploitIds    String[] // FK into vulnerability_knowledge_base
  similarityScores     Float[]  // parallel array
  generatedBy          String   // e.g. "claude-opus-4-7"
  createdAt            DateTime @default(now())

  @@map("finding_enhancements")
}

// Embedding cache — avoids re-generating identical text embeddings.
model EmbeddingCache {
  id        String   @id @default(cuid())
  textHash  String   @unique // sha256 of the text, hex
  model     String
  // cached_embedding: vector(1536) — added via raw SQL migration
  createdAt DateTime @default(now())

  @@map("embedding_cache")
}
